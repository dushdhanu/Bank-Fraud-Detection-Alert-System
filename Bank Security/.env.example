# Copy to .env. Use the SAME development project for all four values.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-publishable-key
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-publishable-key
# Never put service-role keys, notification tokens, or database passwords in VITE_*.
